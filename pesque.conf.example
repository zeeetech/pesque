# pesque configuration.
#
# Every setting here can also come from the environment, and the environment
# wins. The variable is this key uppercased with a PDS_ prefix, so `hostname`
# is `PDS_HOSTNAME` and `port` is `PDS_PORT`.
#
# Point the server at this file with PDS_CONFIG, or leave it as `pesque.conf`
# in the working directory. In the container the path is /data/pesque.conf, on
# the volume, so mounting one file is enough.
#
# Generated by `pesque config template`; the keys it offers are the keys the
# server reads.

# The host this server is reached at.
hostname = pds.example.com

# conformant_single serves one account as the server itself. path_multi
# gives every account its own handle and DID.
mode = path_multi

# web mints did:web accounts from the hostname. plc mints did:plc through
# the PLC directory, and requires mode = path_multi.
identity = plc

# The domain accounts get handles under.
handle_domain = example.com

# open lets anyone create an account; closed needs an invite code.
registration = closed

# Relays to announce this server to at boot, comma separated. Unset (or
# empty) asks nobody.
# crawler = https://bsky.network

# Where the database, keys, blobs and secret live. A relative path is
# relative to the working directory.
# data_dir = data

# What conformant_single publishes as the account's handle. Defaults to
# the hostname; path_multi ignores it.
# handle = pds.example.com

# The port this process listens on.
# port = 4000

# The scheme clients are told to reach this server at. The container
# speaks plain HTTP behind a TLS proxy, so https is the arrangement the
# defaults expect.
# url_scheme = https

# The advertised port. Defaults to 443 under https, and to port otherwise.
# url_port = 443

# The PLC directory. Only read when identity = plc.
# plc_directory = https://plc.directory

# The https base URL permission sets are fetched from when they are not
# vendored with the server. Unset (or empty) fetches nothing, so only the
# vendored sets resolve.
# lexicon_aggregator = https://lexicon.example.com

# The largest uploadBlob accepts, in bytes. 5242880 is 5 MiB.
# blob_upload_limit = 5242880

# The largest importRepo accepts, in bytes. 104857600 is 100 MiB.
# repo_import_limit = 104857600

# How long a proxied call may take before it is answered 504, in
# milliseconds.
# proxy_timeout = 15000

# The largest body a proxied call may return, in bytes.
# proxy_response_limit = 10485760

# The operators, comma separated: the callers the admin endpoints answer.
# Empty means the server identity under conformant_single, and nobody
# under path_multi.
# admin_dids = did:plc:...,did:web:...

# Your own privacy policy, published by describeServer. Unset means the
# links map omits it, which is right when you have none to stand behind.
# privacy_policy_url = https://example.com/privacy

# Your own terms of service, published by describeServer. Unset means the
# links map omits it.
# terms_of_service_url = https://example.com/terms

# Whether to start the HTTP endpoint. The one-off verbs set PDS_SERVE=false
# so they do not fight the running server for the port; leave this unset.
# serve = true

