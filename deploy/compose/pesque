#!/bin/sh
# Host adapter for the versioned Compose deployment bundle. Docker Compose owns
# lifecycle; this command forwards domain work and enforces cold restore.
set -eu

root=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)
compose_file=$root/compose.yaml
config_file=$root/pesque.conf
example_file=$root/pesque.conf.example
backup_dir=$root/backups
newline=$(printf '\nx')
newline=${newline%x}

die() {
  code=$1
  shift
  printf 'error: %s\n' "$*" >&2
  exit "$code"
}

note() { printf 'note: %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
usage: ./pesque <command> [arguments]

  init                              copy the config example without overwriting files
  backup [--out /backups]           write an archive under ./backups
  restore ARCHIVE_NAME [--dry-run]  restore a file from ./backups while cold
  config template [--out PATH]      copy or print the generated application config
  <domain command>                  run a Pesque release command

Lifecycle uses Docker Compose directly:
  docker compose up --detach --wait
  docker compose stop pesque
USAGE
}

compose() {
  docker compose --project-directory "$root" --file "$compose_file" "$@"
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die 3 "docker is required for this deployment"
  docker compose version >/dev/null 2>&1 || die 3 "Docker Compose v2 is required"
  docker info >/dev/null 2>&1 || die 3 "the Docker daemon is not running"
}

need_deployment() {
  [ -f "$compose_file" ] || die 3 "missing Compose definition: $compose_file"
  [ -f "$config_file" ] || die 3 "missing $config_file; run './pesque init' and edit it first"
  [ -d "$backup_dir" ] || die 3 "missing $backup_dir; run './pesque init' first"
}

copy_if_missing() {
  source=$1
  destination=$2
  if [ -e "$destination" ]; then
    note "$destination exists; leaving it unchanged"
  else
    cp "$source" "$destination" || die 3 "could not write $destination"
    printf 'wrote %s\n' "$destination"
  fi
}

init() {
  [ -f "$example_file" ] || die 3 "missing bundled config example: $example_file"
  copy_if_missing "$example_file" "$config_file"
  mkdir -p "$backup_dir" || die 3 "could not create $backup_dir"
}

config_template() {
  [ -f "$example_file" ] || die 3 "missing bundled config example: $example_file"
  if [ "$#" -eq 0 ]; then
    cat "$example_file"
    return
  fi
  if [ "$#" -eq 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then
    printf 'usage: ./pesque config template [--out PATH]\n'
    return
  fi
  if [ "$#" -ne 2 ] || [ "$1" != --out ]; then
    die 2 "usage: ./pesque config template [--out PATH]"
  fi
  [ ! -e "$2" ] || die 1 "refusing to overwrite $2"
  cp "$example_file" "$2" || die 3 "could not write $2"
  printf 'wrote %s\n' "$2"
}

run_once() {
  if [ -t 0 ] && [ -t 1 ]; then
    compose run --rm --no-deps -it pesque "$@"
  else
    compose run --rm --no-deps -i pesque "$@"
  fi
}

run_with_env() {
  key=$1
  shift
  if [ -t 0 ] && [ -t 1 ]; then
    compose run --rm --no-deps -it -e "$key" pesque "$@"
  else
    compose run --rm --no-deps -i -e "$key" pesque "$@"
  fi
}

run_domain() {
  verb=$1
  shift
  need_deployment
  need_docker

  case "$verb" in
    migrate)
      if [ "${MIGRATE_PLC_TOKEN+x}" = x ]; then
        run_with_env MIGRATE_PLC_TOKEN eval 'Pesque.Cli.main()' migrate "$@"
      else
        run_once eval 'Pesque.Cli.main()' migrate "$@"
      fi
      ;;
    account)
      if [ "${PDS_PUBLIC_IP+x}" = x ]; then
        run_with_env PDS_PUBLIC_IP eval 'Pesque.Cli.main()' account "$@"
      else
        run_once eval 'Pesque.Cli.main()' account "$@"
      fi
      ;;
    *)
      run_once eval 'Pesque.Cli.main()' "$verb" "$@"
      ;;
  esac
}

prepare_backup_directory() {
  # The command runs inside the container.
  # shellcheck disable=SC2016
  if compose run --rm --no-deps --entrypoint /bin/sh pesque \
    -c 'probe=$(mktemp /backups/.pesque-write-test.XXXXXX) && rm "$probe"'; then
    return
  fi

  # Only this bind mount is changed; the server and release commands stay non-root.
  compose run --rm --no-deps --user 0 --entrypoint /bin/sh pesque \
    -c 'chown pesque:pesque /backups && chmod 0700 /backups' ||
    die 3 "could not prepare backup directory ownership for the pesque container user"
}

backup() {
  if [ "$#" -eq 0 ]; then
    :
  elif [ "$#" -eq 2 ] && [ "$1" = --out ] && [ "$2" = /backups ]; then
    :
  else
    die 2 "the Compose bundle writes backups only to /backups (host path: $backup_dir)"
  fi

  need_deployment
  need_docker
  prepare_backup_directory
  printf 'Backups: %s on host, /backups in container\n' "$backup_dir"
  run_once eval 'Pesque.Cli.main()' backup --out /backups
}

restore() {
  if [ "$#" -eq 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then
    printf 'usage: ./pesque restore ARCHIVE_NAME [--dry-run]\n'
    return
  fi

  dry_run=0
  case "$#" in
    1) archive=$1 ;;
    2)
      [ "$2" = --dry-run ] || die 2 "usage: ./pesque restore ARCHIVE_NAME [--dry-run]"
      archive=$1
      dry_run=1
      ;;
    *) die 2 "usage: ./pesque restore ARCHIVE_NAME [--dry-run]" ;;
  esac
  case "$archive" in
    '' | . | .. | -* | */* | *"$newline"*)
      die 2 "ARCHIVE_NAME must be a filename directly inside $backup_dir"
      ;;
  esac
  [ -f "$backup_dir/$archive" ] || die 1 "backup archive not found: $backup_dir/$archive"

  need_deployment
  need_docker

  if [ "$dry_run" -eq 0 ] && [ -n "$(compose ps --quiet pesque)" ]; then
    die 3 "the Compose service is running; stop it with 'docker compose stop pesque' before restore"
  fi

  if [ "$dry_run" -eq 1 ]; then
    run_once eval 'Pesque.Cli.main()' restore --dry-run "/backups/$archive"
  else
    run_once eval 'Pesque.Cli.main()' restore "/backups/$archive"
  fi
}

main() {
  [ "$#" -gt 0 ] || { usage; return 2; }
  command=$1
  shift

  case "$command" in
    --help | -h | help) usage ;;
    init)
      [ "$#" -eq 0 ] || die 2 "usage: ./pesque init"
      init
      ;;
    config)
      if [ "${1:-}" = template ]; then
        shift
        config_template "$@"
      else
        run_domain config "$@"
      fi
      ;;
    backup) backup "$@" ;;
    restore) restore "$@" ;;
    *) run_domain "$command" "$@" ;;
  esac
}

main "$@"
