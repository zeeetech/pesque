#!/bin/sh
# Host adapter for the versioned Compose deployment bundle. Docker Compose owns
# lifecycle; this command forwards domain work and enforces cold restore.
set -eu

root=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)
compose_file=$root/compose.yaml
config_file=$root/pesque.conf
example_file=$root/pesque.conf.example
backup_dir=$root/backups
newline=$(printf '\nx')
newline=${newline%x}

die() {
  code=$1
  shift
  printf 'error: %s\n' "$*" >&2
  exit "$code"
}

note() { printf 'note: %s\n' "$*" >&2; }

usage() {
  cat <<'USAGE'
usage: ./pesque <command> [arguments]

  init                              copy the config example without overwriting files
  backup [--out /backups]           write an archive under ./backups
  restore ARCHIVE_NAME [--dry-run]  restore a file from ./backups while cold
  <domain command>                  run a Pesque release command

Lifecycle uses Docker Compose directly:
  docker compose up --detach --wait
  docker compose stop pesque
USAGE
}

compose() {
  docker compose --project-directory "$root" --file "$compose_file" "$@"
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die 3 "docker is required for this deployment"
  docker compose version >/dev/null 2>&1 || die 3 "Docker Compose v2 is required"
  docker info >/dev/null 2>&1 || die 3 "the Docker daemon is not running"
}

need_deployment() {
  [ -f "$compose_file" ] || die 3 "missing Compose definition: $compose_file"
  [ -f "$config_file" ] || die 3 "missing $config_file; run './pesque init' and edit it first"
  [ -d "$backup_dir" ] || die 3 "missing $backup_dir; run './pesque init' first"
}

copy_if_missing() {
  source=$1
  destination=$2
  if [ -e "$destination" ]; then
    note "$destination exists; leaving it unchanged"
  else
    cp "$source" "$destination" || die 3 "could not write $destination"
    printf 'wrote %s\n' "$destination"
  fi
}

init() {
  [ -f "$example_file" ] || die 3 "missing bundled config example: $example_file"
  copy_if_missing "$example_file" "$config_file"
  mkdir -p "$backup_dir" || die 3 "could not create $backup_dir"
}

run_compose() {
  if [ -t 0 ] && [ -t 1 ]; then
    set -- -it "$@"
  else
    set -- -i "$@"
  fi
  compose run --rm --no-deps "$@"
}

run_once() { run_compose pesque "$@"; }

run_with_env() {
  key=$1
  shift
  run_compose -e "$key" pesque "$@"
}

run_domain() {
  verb=$1
  shift
  need_deployment
  need_docker

  case "$verb" in
    migrate)
      if [ "${MIGRATE_PLC_TOKEN+x}" = x ]; then
        run_with_env MIGRATE_PLC_TOKEN eval 'Pesque.Cli.main()' migrate "$@"
      else
        run_once eval 'Pesque.Cli.main()' migrate "$@"
      fi
      ;;
    account)
      run_once eval 'Pesque.Cli.main()' account "$@"
      ;;
    *)
      run_once eval 'Pesque.Cli.main()' "$verb" "$@"
      ;;
  esac
}

backup_stat() {
  if output=$(stat -c '%a %g' "$backup_dir" 2>/dev/null); then
    printf '%s\n' "$output"
    return
  fi
  stat -f '%Lp %g' "$backup_dir"
}

backup_directory_usable() {
  host_gid=$1

  if ! probe_path=$(compose run --rm --no-deps --entrypoint /bin/sh pesque \
    -c "probe=\$(mktemp /backups/.pesque-write-test.XXXXXX) || exit 1
        mode=\$(printf '%o' \$((0666 & ~0\$(umask)))) || exit 1
        chmod \"\$mode\" \"\$probe\" || exit 1
        printf '%s\n' \"\${probe##*/}\"" 2>/dev/null); then
    return 1
  fi

  probe=${probe_path##*/}
  case "$probe" in
    .pesque-write-test.*) ;;
    *) return 1 ;;
  esac

  if ! cat "$backup_dir/$probe" >/dev/null 2>&1; then
    compose run --rm --no-deps --env PROBE="/backups/$probe" \
      --entrypoint /bin/sh pesque -c "rm -f -- \"\$PROBE\"" >/dev/null 2>&1 || :
    return 1
  fi

  if ! compose run --rm --no-deps --env PROBE="/backups/$probe" \
    --entrypoint /bin/sh pesque -c "rm -f -- \"\$PROBE\"" >/dev/null 2>&1; then
    return 1
  fi

  [ -r "$backup_dir" ] && [ -x "$backup_dir" ] || return 1

  if ! state=$(backup_stat); then
    return 1
  fi
  mode=${state%% *}
  gid=${state#* }

  [ "$gid" = "$host_gid" ] || return 1
  case "$mode" in
    *0) return 0 ;;
    *) return 1 ;;
  esac
}

repair_backup_directory() {
  host_gid=$1

  # Only the backup mount is changed; the server and one-off commands stay
  # non-root. The container user owns the directory, the operator's primary
  # group can list and read it, and setgid makes new archives inherit that
  # group.
  compose run --rm --no-deps --user 0 --entrypoint /bin/sh pesque \
    -c "chown pesque:$host_gid /backups && chmod 2770 /backups" ||
    die 3 "could not prepare backup directory permissions for container user and host group $host_gid"
}

prepare_backup_directory() {
  host_gid=$(id -g)
  case "$host_gid" in
    '' | *[!0-9]*) die 3 "could not determine the host GID for the backup directory" ;;
  esac

  if backup_directory_usable "$host_gid"; then
    return
  fi

  repair_backup_directory "$host_gid"
  backup_directory_usable "$host_gid" ||
    die 3 "the backup directory is not writable by the container, readable by host group $host_gid, and private to other users"
}

backup() {
  if [ "$#" -eq 0 ]; then
    :
  elif [ "$#" -eq 2 ] && [ "$1" = --out ] && [ "$2" = /backups ]; then
    :
  else
    die 2 "the Compose bundle writes backups only to /backups (host path: $backup_dir)"
  fi

  need_deployment
  need_docker
  prepare_backup_directory
  printf 'Backups: %s on host, /backups in container\n' "$backup_dir"
  run_once eval 'Pesque.Cli.main()' backup --out /backups
}

restore() {
  if [ "$#" -eq 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then
    printf 'usage: ./pesque restore ARCHIVE_NAME [--dry-run]\n'
    return
  fi

  dry_run=0
  case "$#" in
    1) archive=$1 ;;
    2)
      [ "$2" = --dry-run ] || die 2 "usage: ./pesque restore ARCHIVE_NAME [--dry-run]"
      archive=$1
      dry_run=1
      ;;
    *) die 2 "usage: ./pesque restore ARCHIVE_NAME [--dry-run]" ;;
  esac
  case "$archive" in
    '' | . | .. | -* | */* | *"$newline"*)
      die 2 "ARCHIVE_NAME must be a filename directly inside $backup_dir"
      ;;
  esac
  [ -f "$backup_dir/$archive" ] || die 1 "backup archive not found: $backup_dir/$archive"

  need_deployment
  need_docker

  if [ "$dry_run" -eq 0 ]; then
    if ! running=$(compose ps --quiet pesque); then
      die 3 "could not query the Compose service state; restore was not run"
    fi
    case "$running" in
      '') ;;
      *"$newline"*) die 3 "unexpected Compose service state; restore was not run" ;;
      *) die 3 "the Compose service is running; stop it with 'docker compose stop pesque' before restore" ;;
    esac
    run_once eval 'Pesque.Cli.main()' restore "/backups/$archive"
  else
    run_once eval 'Pesque.Cli.main()' restore --dry-run "/backups/$archive"
  fi
}

main() {
  [ "$#" -gt 0 ] || { usage; return 2; }
  command=$1
  shift

  case "$command" in
    --help | -h | help) usage ;;
    init)
      [ "$#" -eq 0 ] || die 2 "usage: ./pesque init"
      init
      ;;
    backup) backup "$@" ;;
    restore) restore "$@" ;;
    *) run_domain "$command" "$@" ;;
  esac
}

main "$@"
