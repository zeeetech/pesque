#: lib/pesque_web/signup_html.ex:155
#, elixir-autogen, elixir-format
msgid "An email is required."
msgstr "Preencha o email."

#: lib/pesque_web/signup_html.ex:51
#, elixir-autogen, elixir-format
msgid "At least 8 characters."
msgstr "Pelo menos 8 caracteres."

#: lib/pesque_web/signup_html.ex:147
#, elixir-autogen, elixir-format
msgid "Choose a name with letters, numbers or hyphen. No dots and no spaces."
msgstr "Escolha um nome com letras, números ou hífen. Sem ponto e sem espaço."

#: lib/pesque_web/signup_html.ex:87
#, elixir-autogen, elixir-format
msgid "Fill in the form to create your account."
msgstr "Preencha o formulário pra criar sua conta."

#: lib/pesque_web/signup_html.ex:41
#, elixir-autogen, elixir-format
msgid "Letters, numbers and hyphen. This is the name people use to find you."
msgstr "Letras, números e hífen. É o nome que as pessoas usam pra te achar."

#: lib/pesque_web/signup_html.ex:119
#, elixir-autogen, elixir-format
msgid "Something went wrong on our side. Try again in a moment. If it keeps happening, tell whoever runs the server."
msgstr "Algo deu errado do nosso lado. Tente de novo em instantes. Se continuar, avise quem cuida do servidor."

#: lib/pesque_web/signup_html.ex:142
#, elixir-autogen, elixir-format
msgid "That code is not valid. It may have expired or already been used. Ask whoever invited you for a new one."
msgstr "Esse código não vale. Ele pode ter expirado ou já ter sido usado. Peça um novo a quem te convidou."

#: lib/pesque_web/signup_html.ex:150
#, elixir-autogen, elixir-format
msgid "That name is already taken here. Choose another."
msgstr "Esse nome já está em uso aqui. Escolha outro."

#: lib/pesque_web/signup_html.ex:94
#, elixir-autogen, elixir-format
msgid "The code whoever invited you sent."
msgstr "O código que quem te convidou mandou."

#: lib/pesque_web/signup_html.ex:153
#, elixir-autogen, elixir-format
msgid "The password needs at least 8 characters."
msgstr "A senha precisa de pelo menos 8 caracteres."

#: lib/pesque_web/signup_html.ex:165
#, elixir-autogen, elixir-format
msgid "This server already has its account."
msgstr "Este servidor já tem a sua conta."

#: lib/pesque_web/signup_html.ex:83
#, elixir-autogen, elixir-format
msgid "This server is invite only. To create an account, you need a code from whoever invited you."
msgstr "Este servidor é só com convite. Pra criar uma conta, você precisa de um código de quem te convidou."

#: lib/pesque_web/signup_html.ex:137
#, elixir-autogen, elixir-format
msgid "This server is invite only. You need a code to create an account."
msgstr "Este servidor é só com convite. Você precisa de um código pra criar uma conta."

#: lib/pesque_web/signup_html.ex:46
#, elixir-autogen, elixir-format
msgid "We do not send confirmation emails. Keep this address: it is how whoever runs the server helps you recover the account."
msgstr "A gente não manda email de confirmação. Guarde este endereço: é por ele que quem cuida do servidor te ajuda a recuperar a conta."

#: lib/pesque_web/signup_html.ex:66
#, elixir-autogen, elixir-format
msgid "Your account is ready. To sign in, open the official Bluesky app and use this name and the password you just chose."
msgstr "Sua conta está pronta. Pra entrar, abra o aplicativo oficial do Bluesky e use este nome e a senha que você acabou de escolher."

