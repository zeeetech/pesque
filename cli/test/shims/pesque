#!/bin/sh
# Fake release `bin/pesque` for the non-root systemd direct-exec path: logs
# argv0 (which $@ omits), its argv, and the PDS_* world it inherited.
log="${PESQUE_FAKE_LOG:?PESQUE_FAKE_LOG must be set}"
{
  printf '%s\n' "$0"
  for a in "$@"; do printf '%s\n' "$a"; done
  printf 'PDS_SERVE=%s\n' "${PDS_SERVE:-unset}"
  printf 'PDS_HOSTNAME=%s\n' "${PDS_HOSTNAME:-unset}"
  printf 'PWD=%s\n' "$(pwd)"
  printf '\n'
} >>"$log"
exit "${PESQUE_FAKE_EXIT:-0}"
