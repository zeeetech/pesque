#!/bin/sh
# Fake `curl` for the Zig driver tests: logs argv; writes
# $PESQUE_FAKE_CURL_BODY to any `-o` target; prints the same body to stdout;
# honours $PESQUE_FAKE_IP for the ipify probe.
log="${PESQUE_FAKE_LOG:?PESQUE_FAKE_LOG must be set}"
{
  for a in "$@"; do printf '%s\n' "$a"; done
  printf '\n'
} >>"$log"

case "$*" in
  *ipify*) printf '%s\n' "${PESQUE_FAKE_IP:-203.0.113.10}" ;;
esac

prev=""
out=""
for a in "$@"; do
  [ "$prev" = "-o" ] && out="$a"
  prev="$a"
done
if [ -n "$out" ]; then
  printf '%s' "${PESQUE_FAKE_CURL_BODY:-}" >"$out" || exit 1
fi
# GET-style calls capture stdout, so echo the body as well.
if [ -z "$out" ] && [ -n "${PESQUE_FAKE_CURL_BODY:-}" ]; then
  printf '%s' "$PESQUE_FAKE_CURL_BODY"
fi
exit "${PESQUE_FAKE_CURL_EXIT:-0}"
