#!/bin/sh
# Deprecated: this used to be a bash wrapper driving docker/compose directly.
# The host-side CLI is now a standalone static binary, distributed through the
# GitHub releases. This shim downloads it (once) and hands over; there is no
# offline fallback. It will be deleted after one minor release.
#
#   scripts/pesque <command> [args...]
set -eu

repo="${PESQUE_REPO:-zeeetech/pesque}"
cache="${PESQUE_CACHE:-$HOME/.cache/pesque}"
notice="$cache/deprecated-notice"

# --- deprecation notice (once) ------------------------------------------------
if [ ! -f "$notice" ]; then
  printf 'note: scripts/pesque is deprecated. Install the standalone CLI instead:\n' >&2
  printf '  curl -fsSL https://raw.githubusercontent.com/%s/main/install.sh | sh\n' "$repo" >&2
  printf 'This shim will be removed after one minor release.\n' >&2
  mkdir -p "$cache" 2>/dev/null || true
  : >"$notice" 2>/dev/null || true
fi

# --- platform -> release target ------------------------------------------------
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) target=aarch64-macos ;;
  Darwin/x86_64) target=x86_64-macos ;;
  Linux/x86_64) target=x86_64-linux-musl ;;
  Linux/aarch64) target=aarch64-linux-musl ;;
  *) printf 'error: no release for %s/%s\n' "$(uname -s)" "$(uname -m)" >&2; exit 3 ;;
esac

# --- resolve latest tag ----------------------------------------------------------
tag_url="https://api.github.com/repos/$repo/releases/latest"
tag="$(curl -fsSL --max-time 30 "$tag_url" |
  sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
[ -n "$tag" ] || { printf 'error: could not resolve the latest release from %s\n' "$tag_url" >&2; exit 3; }

# --- download (cached per tag) and verify ----------------------------------------
bin="$cache/pesque-$tag"
if [ ! -x "$bin" ]; then
  base="https://github.com/$repo/releases/download/$tag"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL --max-time 30 -o "$tmp/pesque-$target" "$base/pesque-$target"
  curl -fsSL --max-time 30 -o "$tmp/SHA256SUMS" "$base/SHA256SUMS"
  want="$(sed -n "s/^\\([0-9a-fA-F]\\{64\\}\\)[[:space:]].*pesque-$target\$/\\1/p" "$tmp/SHA256SUMS")"
  [ -n "$want" ] || { printf 'error: no checksum for pesque-%s in SHA256SUMS\n' "$target" >&2; exit 3; }
  if command -v sha256sum >/dev/null 2>&1; then
    got="$(sha256sum "$tmp/pesque-$target" | cut -d' ' -f1)"
  elif command -v shasum >/dev/null 2>&1; then
    got="$(shasum -a 256 "$tmp/pesque-$target" | cut -d' ' -f1)"
  else
    printf 'error: need sha256sum or shasum to verify the download\n' >&2; exit 3
  fi
  [ "$got" = "$want" ] || { printf 'error: checksum mismatch for pesque-%s\n' "$target" >&2; exit 3; }
  mkdir -p "$cache"
  mv "$tmp/pesque-$target" "$bin"
  chmod +x "$bin"
fi

exec "$bin" "$@"
