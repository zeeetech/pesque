# Oneshot driven by pesque-update.timer: back up, then update.
#
# `pesque update` (the host CLI) resolves the systemd backend: it downloads
# the newest release tarball from GitHub, verifies it against SHA256SUMS,
# swaps the /opt/pesque symlink and restarts the service unit. It restarts
# even when the release is already current, which is why the timer runs
# weekly and not nightly.
#
# The backup first is the rollback path: there is no down migration, so a
# bad upgrade is recovered by restoring the pre-upgrade archive (pesque
# restore). ExecStart lines run in order and stop at the first failure, so
# the update never runs without a fresh archive beside it.
#
# Assumes the host CLI at /usr/local/bin/pesque (adjust to where install.sh
# put it) and the service unit named pesque; set PESQUE_SERVICE to run a
# differently named one. PESQUE_BACKEND pins the backend so detection cannot
# be confused by a docker-compose.yml near the working directory.

[Unit]
Description=pesque automatic update (backup, then pull and restart)
Documentation=https://github.com/zeeetech/pesque/blob/main/docs/guides/operations.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PESQUE_BACKEND=systemd
# The CLI runs one-off verbs as the pesque user; the archive holds
# server.secret and the keys, so it gets the data directory's own mode.
ExecStartPre=/usr/bin/install -d -m 0700 -o pesque -g pesque /var/backups/pesque
ExecStart=/usr/local/bin/pesque backup --out /var/backups/pesque
ExecStart=/usr/local/bin/pesque update
# PrivateTmp is safe here because the CLI hands the manager its run-once
# environment mirror under /run, which PrivateTmp does not hide. Older CLIs
# mirrored it under $TMPDIR and this unit then failed to load: keep the CLI
# at the release that ships with the unit.
PrivateTmp=true
NoNewPrivileges=true
