# Weekly window for pesque-update.service. Persistent=true catches up a
# machine that was off at the scheduled time; RandomizedDelaySec keeps a
# fleet of pesque servers from arriving at the release download together.

[Unit]
Description=weekly pesque update window
Documentation=https://github.com/zeeetech/pesque/blob/main/docs/guides/operations.md

[Timer]
OnCalendar=Sun *-*-* 03:17:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
